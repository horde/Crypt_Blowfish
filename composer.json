{
    "name": "horde/crypt_blowfish",
    "description": "Blowfish encryption library",
    "type": "library",
    "homepage": "https://www.horde.org/libraries/Horde_Crypt_Blowfish",
    "license": "LGPL-2.1-only",
    "authors": [
        {
            "name": "Michael Slusarz",
            "email": "slusarz@horde.org",
            "role": "lead"
        }
    ],
    "keywords": [
        "encryption",
        "blowfish"
    ],
    "time": "2026-04-10",
    "repositories": [],
    "require": {
        "php": "^7.4 || ^8",
        "horde/exception": "^3 || dev-FRAMEWORK_6_0",
        "horde/support": "^3 || dev-FRAMEWORK_6_0"
    },
    "require-dev": {
        "horde/test": "^3 || dev-FRAMEWORK_6_0"
    },
    "suggest": {
        "ext-mcrypt": "*",
        "ext-openssl": "*"
    },
    "autoload": {
        "psr-0": {
            "Horde_Crypt_Blowfish": "lib/"
        },
        "psr-4": {
            "Horde\\Crypt\\Blowfish\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Crypt\\Blowfish\\Test\\": "test/"
        }
    },
    "config": {
        "allow-plugins": {}
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "2.x-dev"
        }
    }
}